<Window
    x:Class="DevHub.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DevHub · 开发环境管理器">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RequestedTheme="Default">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Padding="20,0,160,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="7" Width="27" Height="27">
                    <FontIcon Glyph="&#xE756;" FontSize="15" Foreground="White" />
                </Border>
                <TextBlock Text="DevHub" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="开发环境管理器" Opacity="0.58" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        PaneDisplayMode="Left" OpenPaneLength="214" IsPaneToggleButtonVisible="True" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="home"><NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="工具库" Tag="tools"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="AI 工具" Tag="agents"><NavigationViewItem.Icon><FontIcon Glyph="&#xE99A;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="版本管理" Tag="versions"><NavigationViewItem.Icon><FontIcon Glyph="&#xE896;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="项目环境" Tag="projects"><NavigationViewItem.Icon><SymbolIcon Symbol="Folder"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="环境诊断" Tag="diagnostics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="缓存与空间" Tag="cache"><NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;"/></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="任务与日志" Tag="tasks"><NavigationViewItem.Icon><SymbolIcon Symbol="List"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Padding="32,16,32,32">
                <Grid HorizontalAlignment="Stretch">
                    <StackPanel x:Name="PageContent" Spacing="20" MaxWidth="1440" HorizontalAlignment="Stretch"/>
                </Grid>
            </ScrollViewer>
        </NavigationView>
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="20,8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <FontIcon x:Name="StatusIcon" Glyph="&#xE930;" FontSize="16" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" Text="准备就绪" FontSize="12"/>
                    <TextBlock x:Name="StatusDetail" Text="所有运行数据保存在项目目录" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <ProgressBar x:Name="TaskProgress" Grid.Column="2" Minimum="0" Maximum="100" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Button x:Name="CancelTaskButton" Grid.Column="3" Content="取消任务" Visibility="Collapsed" Click="CancelTask_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
