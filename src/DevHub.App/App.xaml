<Application
    x:Class="DevHub.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="DevHubCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="20"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            </Style>
            <Style x:Key="DevHubStatStyle" TargetType="Button">
                <Setter Property="Padding" Value="20"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
